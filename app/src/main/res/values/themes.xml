<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VideoFetcher" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Blocks MIUI/HyperOS from violently inverting your Jetpack Compose colors -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- Blocks MIUI/HyperOS Force Dark on the Quick Share overlay without losing transparency -->
    <style name="Theme.VideoFetcher.Translucent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>